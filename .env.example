# CodeCraft: Galactic Developer - Environment Configuration
# Copy this file to .env.local and fill in the values

# =============================================================================
# APPLICATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://codecraft-dev.vercel.app
NEXT_PUBLIC_APP_NAME="CodeCraft: Galactic Developer"

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
# PostHog - Product Analytics
# Get your key at https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# REAL-TIME / MULTIPLAYER (Optional)
# =============================================================================
# Liveblocks - Collaborative Features
# Get your key at https://liveblocks.io
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_SECRET_KEY=

# PartyKit - Game Rooms (Alternative)
# Get your key at https://partykit.io
NEXT_PUBLIC_PARTYKIT_HOST=

# =============================================================================
# LEARNING ANALYTICS (Optional)
# =============================================================================
# xAPI / Learning Record Store
XAPI_LRS_ENDPOINT=
XAPI_LRS_USERNAME=
XAPI_LRS_PASSWORD=

# =============================================================================
# ERROR MONITORING (Optional)
# =============================================================================
# Sentry - Error Tracking
# Get your DSN at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# =============================================================================
# ASSET STORAGE (Optional)
# =============================================================================
# Cloudflare R2 - 3D Asset Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=codecraft-assets
NEXT_PUBLIC_ASSETS_URL=

# =============================================================================
# CODE EXECUTION (Optional)
# =============================================================================
# Judge0 CE - Code Execution Engine
# Self-hosted: Set your Judge0 CE instance URL
# RapidAPI: Get your key at https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
NEXT_PUBLIC_ENABLE_MULTIPLAYER=false
NEXT_PUBLIC_ENABLE_SOUND=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_DEBUG_MODE=false

# Axiom Log Aggregation (https://axiom.co - free 500GB/month)
NEXT_PUBLIC_AXIOM_DATASET=
AXIOM_TOKEN=
